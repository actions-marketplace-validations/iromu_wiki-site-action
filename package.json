{
  "name": "wiki-site-action",
  "version": "2.0.1",
  "private": true,
  "description": "GitHub Action that builds a .wiki/ knowledge base into a static site.",
  "type": "module",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "node scripts/copy-assets.js && esbuild src/index.js --bundle --platform=node --format=cjs --target=node24 --outfile=dist/index.cjs",
    "test": "node test/smoke.js",
    "preview": "node scripts/preview.js"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.12",
    "marked-highlight": "^2.2.4"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
